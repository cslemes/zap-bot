TRANSCRIPTION_ENDPOINT=https://your-provider.example/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Set false to skip group audio downloads and transcription
TRANSCRIBE_GROUPS=true
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
